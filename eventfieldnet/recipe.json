{
  "base_checkpoint": null,
  "checkpointing": {
    "enabled": true,
    "evaluator_version": "official_validation_fixed_fullgrid_nms05_with_raw_round31",
    "keep_epoch_checkpoints": false,
    "official_batch_size": 64,
    "official_device": "cuda:0",
    "stop_on_evaluation_failure": true
  },
  "data_factory": {
    "kwargs": {
      "root": "@ROOT@"
    },
    "target": "backbone.conditioned.paired_loader:build_repository_data_with_paired_rng"
  },
  "ema_enabled": false,
  "evaluator_factory": {
    "kwargs": {
      "max_candidates": 30,
      "nms_iou_threshold": 0.5,
      "precision": "fp32",
      "project_root": "@ROOT@",
      "root": "@ROOT@",
      "timeout_seconds": 240,
      "wrapper": "@ROOT@/backbone/conditioned/official_eval.py"
    },
    "target": "eventfieldnet.hd_evaluator:build_evaluator"
  },
  "grad_accumulation": 1,
  "model_factory": {
    "kwargs": {
      "a_local_evidence": true,
      "aux_detach_input": false,
      "b_edge_support": true,
      "c_latent_composition": false,
      "carrier_mode": "tanh",
      "conditioner_output_gain": 0.1,
      "counterfactual_video_key": "src_vid",
      "counterfactual_visual_channels": 512,
      "e_readout_scale": "fixed_init",
      "evidence_input_mode": "token_attention_product",
      "evidence_reduction": "candidate_mean",
      "evidence_supervision": "wrong_query",
      "extension_lr": 6e-05,
      "fixed_control_bits": 7,
      "independent_s_projection": true,
      "initial_field_gate": 0.05,
      "input_field_rank": 64,
      "loss_weights": {
        "endpoint": 0.1,
        "evidence": 0.1,
        "rank": 0.5,
        "support": 0.1,
        "transition": 0.1
      },
      "max_update_ratio": 0.05,
      "min_span_clips": 1,
      "quality_stratified": true,
      "query_relative_e": false,
      "rank_candidate_pair": true,
      "rank_competition": "global",
      "rank_form": "dense",
      "rank_kl_half": false,
      "rank_logit_scale": 2.0,
      "rank_margin": 0.1,
      "rank_mode": "gt_balanced_kl",
      "rank_stop_s": false,
      "rank_target_exponent": 4.0,
      "rank_target_threshold": 0.7,
      "scratch_residual_gate": 0.05,
      "scratch_total_epochs": 420,
      "selector_lr": 0.0001,
      "support_candidate_chunk_size": 128,
      "support_conditioning_position": "post_encoder",
      "support_deployment": "in_score",
      "support_hops": 1,
      "support_input": "rms",
      "support_input_mode": "query_agreement_transport",
      "support_length_center": false,
      "support_mode": "nonlinear",
      "support_pair_mode": "joint_residual",
      "support_readout": "edge_mean",
      "support_wide_pair": true,
      "trainability": "full_path",
      "transition_barrier": true,
      "transition_conditioning_position": "pre_encoder",
      "transition_context_mode": "none",
      "transition_input_mode": "query_agreement_delta",
      "transition_target_mode": "independent_max",
      "variant": "y21",
      "counterfactual_support_mix": 0.0,
      "r51_spec": {},
      "r53_spec": {},
      "r54_spec": {},
      "r58_spec": {
        "mode": "kl_plus_quality",
        "bias": false
      },
      "r58_bias_init": 0.0,
      "r59_spec": {
        "mode": "local_s_coverage"
      },
      "r68_spec": {
        "mode": "hinge_legacy_route"
      },
      "long_s_spec": {
        "upper": false,
        "long_weight": false
      },
      "followup_spec": {
        "edge_route": true,
        "long_kl": false
      },
      "annotation_files": [
        "@ROOT@/data/qvhighlights/annotation/highlight_train_release.jsonl",
        "@ROOT@/data/qvhighlights/annotation/highlight_val_release.jsonl"
      ],
      "cf_arm": "C02"
    },
    "target": "eventfieldnet.evidence_supervision.model:build_model"
  },
  "negative_selection_mode": "hardest",
  "optimizer_lr_scale": 1.0,
  "resume": false,
  "schedule_epochs": 24,
  "schema": "eventfieldnet_trifield_round31_config_v1",
  "source_roots": [
    "@ROOT@"
  ],
  "rank_topk_restrict": 30,
  "rank_length_reweight_gain": 0.15,
  "support_shift_relaxed_fallback": false,
  "lr_schedule_mode": "milestone",
  "train": {
    "entrypoint": "eventfieldnet.engine"
  },
  "name": "eventfieldnet"
}
